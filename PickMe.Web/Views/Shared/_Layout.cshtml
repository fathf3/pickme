<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PickMe</title>

    <!-- Sayfa Açýklamasý -->
    <meta name="description" content="En popüler anketleri keþfedin ve oyunuzu kullanýn. Hemen katýlýn ve sonuçlarý görün!">

    <!-- Anahtar Kelimeler -->
    <meta name="keywords" content="anket, anket sitesi, oylama, anket oluþtur, en popüler anketler, pickme, survey">

    <!-- Sayfa Yazarý -->
    <meta name="author" content="Pickme">

    <!-- Facebook (Open Graph) Meta Etiketleri -->
    <meta property="og:title" content="En Popüler Anketler - Pickme">
    <meta property="og:description" content="En popüler anketleri keþfedin ve oyunuzu kullanýn.">
    <meta property="og:image" content="~/images/logo/logo.png">
    <meta property="og:url" content="https://www.pickme.com">
    <meta property="og:type" content="website">

    <!-- Twitter Kartý -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="En Popüler Anketler - Pickme">
    <meta name="twitter:description" content="En popüler anketleri keþfedin ve oyunuzu kullanýn.">
    <meta name="twitter:image" content="~/images/logo/logo.png">


    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PickMe.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6637138831302972"
            crossorigin="anonymous"></script>
    <link rel="icon" type="image/x-icon" href="~/images/logo/icon.ico" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo/logo.png" alt="Logo" width="100" height="40" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                       @*  <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Survey" asp-action="Index">Anketler</a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Survey" asp-action="Create">Yeni Anket</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("User"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Survey" asp-action="MySurvey">Anketlerim</a>
                            </li>
                        }
                         @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin Panel
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Kullanýcýlar</a></li>
                                    <li><a class="dropdown-item" asp-controller="Survey" asp-action="AdminIndex">Anketler</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="Index">Þikayetler</a></li>
                                    <li><a class="dropdown-item" asp-controller="Category" asp-action="Index">Kategoriler</a></li>
                                </ul>
                            </li>
                         } 
                      
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container" style="display: flex; justify-content: space-between;">
            <span>&copy; @DateTime.Today.Year - PickMe</span>
            <span>
                <a href="https://twitter.com" target="_blank"><i class="bi bi-twitter"></i></a>
                <a href="https://www.instagram.com/pickme.social" target="_blank"><i class="bi bi-instagram"></i></a>
                <a href="https://www.tiktok.com/&#64;pickme.social" target="_blank"><i class="bi bi-tiktok"></i></a>
            </span>
            <span>Designed by <a href="http://fatih-mutlu.com/">Fatih Mutlu</a></span>
        </div>

       
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
