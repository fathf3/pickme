@model IEnumerable<PickMe.Core.Models.Survey>
@using System.Security.Claims

@{
    ViewData["Title"] = "Ana Sayfa";
    var categories = ViewBag.Categories as List<Category>;
    int? selectedCategory = ViewBag.SelectedCategory as int?;
    string selectedFilter = ViewBag.SelectedFilter as string;

}

@if (TempData["ReportSuccess"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toastElement = document.getElementById("report-toast");
            var toast = new bootstrap.Toast(toastElement);
            toast.show();
        });
    </script>

    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="report-toast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["ReportSuccess"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<div class="text-center mb-4">
    <h1 class="display-4">PickMe'ye Hoş Geldiniz</h1>
    
</div>
<form method="get" action="@Url.Action("Index")">
    <div class="row mb-3">
        <div class="col-md-6">
            <label for="categoryFilter" class="form-label">Kategori Seç:</label>
            <select id="categoryFilter" name="categoryId" class="form-select" onchange="this.form.submit()">
                <option value="">Tüm Kategoriler</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id" selected="@(category.Id == selectedCategory ? "selected" : null)">
                        @category.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-6">
            <label for="filterType" class="form-label">Sırala:</label>
            <select id="filterType" name="filterType" class="form-select" onchange="this.form.submit()">
                <option value="">En Yeni</option>
                <option value="mostLiked" selected="@(selectedFilter == "mostLiked" ? "selected" : null)">En Beğenilen</option>
                <option value="mostCommented" selected="@(selectedFilter == "mostCommented" ? "selected" : null)">En Çok Yorum Alan</option>
            </select>
        </div>
    </div>
</form>

<div id="message-container" class="alert-message "></div>

