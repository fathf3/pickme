<div class="row">
    @foreach (var survey in Model)
    {
        int totalVotes = survey.Image1Votes + survey.Image2Votes;
        double image1Percentage = totalVotes > 0 ? (survey.Image1Votes * 100.0 / totalVotes) : 0;
        double image2Percentage = totalVotes > 0 ? (survey.Image2Votes * 100.0 / totalVotes) : 0;
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <a asp-controller="Survey" asp-action="Details" asp-route-id="@survey.Id"> <h5 class="card-title mb-0">@survey.Title</h5></a>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="row d-flex flex-wrap">
                            <div class="col-6 text-center">
                                <div class="image-container">
                                    <img src="@survey.Image1Url" alt="Resim 1" class="survey-image img-fluid w-100 vote-button" data-survey-id="@survey.Id" data-image="1">
                                    
                                </div>
                                <p></p>
                                <span class="btn btn-sm btn-primary">@survey.Image1Votes <i class="bi bi-person"></i></span>
                            </div>
                            <div class="col-6 text-center">
                                <div class="image-container">
                                    <img src="@survey.Image2Url" alt="Resim 2" class="survey-image img-fluid w-100 vote-button" data-survey-id="@survey.Id" data-image="2">
                                    
                                </div>
                                <p></p>
                                <span class="btn btn-sm btn-primary">@survey.Image2Votes <i class="bi bi-person"></i></span>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="progress-container">
                        <div class="progress-bar-custom bg-blue-gradient" style="width: @image1Percentage%;">
                            @image1Percentage.ToString("0.##")%
                        </div>
                        <div class="progress-bar-custom bg-light-blue" style="width: @image2Percentage%;">
                            @image2Percentage.ToString("0.##")%
                        </div>
                    </div>
                    <p class="card-text mt-3">@survey.Description</p>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <form asp-controller="Survey" asp-action="ToggleLike" method="post" class="d-inline">
                                <input type="hidden" name="surveyId" value="@survey.Id" />
                                <button type="submit" class="btn @(survey.Likes?.Any(l => l.UserId == User?.FindFirstValue(ClaimTypes.NameIdentifier)) == true ? "btn-danger" : "btn-outline-danger")">
                                    <i class="bi bi-heart-fill"></i> @(survey.Likes?.Count ?? 0)
                                </button>
                            </form>
                        </div>
                        <a asp-controller="Survey" asp-action="Details" asp-route-id="@survey.Id">
                            <div class="d-flex justify-content-between">
                                <button type="submit" class="btn btn-outline-primary">
                                    <i class="bi bi-chat-dots"></i> @(survey.Comments?.Count ?? 0)
                                </button>
                            </div>
                        </a>
                        <button class="btn btn-warning" data-survey-id="@survey.Id"
                                data-bs-toggle="modal" data-bs-target="#reportModal">
                            <i class="bi bi-flag-fill"></i> Şikayet Et
                        </button>
                    </div>
                </div>

                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">@survey.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">Oluşturan: @survey.CreatedBy?.UserName</small>
                        </div>
                        <a asp-controller="Survey" asp-action="Details" asp-route-id="@survey.Id" class="btn btn-primary btn-sm">Detaylar</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Report Modal -->
<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Survey" asp-action="Report" method="post">
                <input type="hidden" id="surveyId" name="surveyId" />
                <div class="modal-header">
                    <h5 class="modal-title">Anketi Şikayet Et</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="reason">Şikayet Nedeni</label>
                        <textarea name="reason" id="reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Şikayet Et</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center">
        <p>Henüz hiç anket oluşturulmamış.</p>
        <a asp-controller="Survey" asp-action="Create" class="btn btn-primary">İlk Anketi Oluştur</a>
    </div>
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var reportModal = document.getElementById('reportModal');
        reportModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget; // Tıklanan butonu al
            var surveyId = button.getAttribute('data-survey-id'); // Butonun içindeki ID'yi al
            console.log(surveyId);
            var inputSurveyId = document.getElementById('surveyId');
            console.log(inputSurveyId);
            if (inputSurveyId) {
                inputSurveyId.value = surveyId; // Modal içindeki input'a ID'yi ata
            }
        });
    });
</script>
<script src="~/js/survey.js" asp-append-version="true"></script>
